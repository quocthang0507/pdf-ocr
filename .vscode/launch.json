{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PDF OCR: chạy ứng dụng",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUTF8": "1",
        "QT_ENABLE_HIGHDPI_SCALING": "1"
      }
    },
    {
      "name": "PDF OCR: chạy toàn bộ kiểm thử",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v", "--cov=src", "--cov-report=term-missing"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}", "PYTHONUTF8": "1" }
    },
    {
      "name": "PDF OCR: kiểm thử giao diện",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-m", "gui", "tests/gui", "-v"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}", "PYTHONUTF8": "1" }
    },
    {
      "name": "PDF OCR: kiểm thử tệp đang mở",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}", "PYTHONUTF8": "1" }
    }
  ]
}

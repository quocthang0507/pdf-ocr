/* Light theme: calm paper surfaces, one blue accent, AA contrast throughout.
   Keep this file's rule order identical to dark_theme.qss so the two stay in step.

   ink            #16202e   surface        #ffffff
   muted ink      #5a6474   canvas         #f5f7fa
   accent         #1d4ed8   raised         #eef1f6
   border         #d8dee7   selection      #dbeafe
*/

QWidget {
    background-color: #f5f7fa;
    color: #16202e;
    font-size: 13px;
    selection-background-color: #dbeafe;
    selection-color: #16202e;
}

QWidget:disabled {
    color: #98a2b3;
}

QMainWindow,
QDialog,
QMessageBox {
    background-color: #f5f7fa;
}

QMessageBox QLabel {
    color: #16202e;
    font-size: 13px;
}

QDialogButtonBox {
    background-color: transparent;
}

QLabel {
    background-color: transparent;
}

QLabel#free_space_label,
QLabel#device_hint,
QLabel#region_result,
QLabel#batch_summary,
QLabel#batch_dialog_eta,
QLabel#download_rate,
QLabel#download_eta,
QLabel#find_status {
    color: #5a6474;
}

QLabel#download_title,
QLabel#dialog_title {
    color: #16202e;
    font-size: 14px;
    font-weight: 600;
    padding-bottom: 2px;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d8dee7;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    border-radius: 6px;
    padding: 6px 10px;
}

QMenuBar::item:selected {
    background-color: #e6edfb;
    color: #1d4ed8;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d8dee7;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    border-radius: 6px;
    padding: 7px 26px 7px 14px;
}

QMenu::item:selected {
    background-color: #e6edfb;
    color: #1d4ed8;
}

QMenu::item:checked {
    background-color: #eef1f6;
    color: #1d4ed8;
    font-weight: 600;
}

QMenu::item:checked:selected {
    background-color: #dbeafe;
    color: #1d4ed8;
    font-weight: 600;
}

QMenu::indicator {
    height: 14px;
    margin-left: 6px;
    width: 14px;
}

QMenu::indicator:checked {
    image: url("@ICONS@/check.svg");
}

QMenu::item:disabled {
    color: #98a2b3;
}

QMenu::separator {
    background-color: #e4e9f0;
    height: 1px;
    margin: 6px 10px;
}

QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d8dee7;
    padding: 6px 8px;
    spacing: 4px;
}

QToolBar::separator {
    background-color: #e4e9f0;
    margin: 4px 6px;
    width: 1px;
}

QToolButton {
    border: 1px solid transparent;
    border-radius: 7px;
    color: #16202e;
    padding: 6px 10px;
}

QToolButton:hover {
    background-color: #eef1f6;
    border-color: #d8dee7;
}

QToolButton:pressed {
    background-color: #dbe3ef;
}

QToolButton:checked {
    background-color: #dbeafe;
    border: 1px solid #1d4ed8;
    color: #1d4ed8;
    font-weight: 600;
}

QToolButton:checked:hover {
    background-color: #bfdbfe;
    border: 1px solid #1d4ed8;
    color: #1d4ed8;
}

QToolButton:disabled {
    color: #98a2b3;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #c9d2df;
    border-radius: 7px;
    color: #16202e;
    min-height: 20px;
    padding: 7px 16px;
}

QPushButton:hover {
    background-color: #eef1f6;
    border-color: #a9b6c9;
}

QPushButton:pressed {
    background-color: #dbe3ef;
}

QPushButton:focus {
    border-color: #1d4ed8;
    outline: none;
}

QPushButton:disabled {
    background-color: #eef1f6;
    border-color: #e4e9f0;
    color: #98a2b3;
}

QPushButton:default {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
    color: #ffffff;
}

QPushButton:default:hover {
    background-color: #1a45c0;
}

QPushButton:default:disabled {
    background-color: #eef1f6;
    border-color: #e4e9f0;
    color: #98a2b3;
}

QDialogButtonBox QPushButton {
    min-width: 68px;
}

QLineEdit,
QTextEdit,
QSpinBox,
QComboBox {
    background-color: #ffffff;
    border: 1px solid #c9d2df;
    border-radius: 7px;
    color: #16202e;
    padding: 6px 10px;
    selection-background-color: #dbeafe;
    selection-color: #16202e;
}

QLineEdit:hover,
QTextEdit:hover,
QSpinBox:hover,
QComboBox:hover {
    border-color: #a9b6c9;
}

QLineEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border-color: #1d4ed8;
}

QLineEdit:disabled,
QTextEdit:disabled,
QSpinBox:disabled,
QComboBox:disabled {
    background-color: #eef1f6;
    color: #98a2b3;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d8dee7;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #e6edfb;
    selection-color: #1d4ed8;
}

QTextEdit#transcript_editor {
    font-size: 14px;
    line-height: 150%;
    padding: 12px 14px;
}

QCheckBox {
    background-color: transparent;
    padding: 4px 2px;
    spacing: 8px;
}

QCheckBox::indicator {
    border: 1px solid #c9d2df;
    border-radius: 4px;
    height: 15px;
    width: 15px;
}

QCheckBox::indicator:hover {
    border-color: #1d4ed8;
}

QCheckBox::indicator:checked {
    image: url("@ICONS@/check.svg");
    background-color: #1d4ed8;
    border-color: #1d4ed8;
}

QCheckBox::indicator:disabled {
    background-color: #eef1f6;
    border-color: #e4e9f0;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d8dee7;
    border-radius: 10px;
    font-weight: normal;
    margin-top: 14px;
    padding: 14px 12px 12px 12px;
}

QGroupBox::title {
    color: #5a6474;
    font-weight: 600;
    left: 12px;
    padding: 0 6px;
    subcontrol-origin: margin;
}

QDockWidget {
    color: #5a6474;
    titlebar-close-icon: none;
}

QDockWidget::title {
    background-color: #eef1f6;
    border-bottom: 1px solid #d8dee7;
    padding: 8px 12px;
}

QGraphicsView#document_canvas {
    background-color: #e9edf3;
    border: none;
}

QListWidget,
QListView,
QTreeWidget,
QTreeView,
QTableWidget,
QTableView {
    alternate-background-color: #f5f7fa;
    background-color: #ffffff;
    border: 1px solid #d8dee7;
    border-radius: 8px;
    gridline-color: #e4e9f0;
    outline: none;
}

QListWidget::item,
QListView::item,
QTreeWidget::item,
QTreeView::item,
QTableWidget::item,
QTableView::item {
    border-radius: 4px;
    padding: 6px 8px;
}

QListWidget::item:hover,
QListView::item:hover,
QTreeWidget::item:hover,
QTreeView::item:hover,
QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #eef1f6;
}

QListWidget::item:selected,
QListView::item:selected,
QTreeWidget::item:selected,
QTreeView::item:selected,
QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #dbeafe;
    color: #16202e;
}

QHeaderView::section {
    background-color: #eef1f6;
    border: none;
    border-bottom: 1px solid #d8dee7;
    border-right: 1px solid #e4e9f0;
    color: #5a6474;
    font-weight: 600;
    padding: 7px 8px;
}

QProgressBar {
    background-color: #eef1f6;
    border: none;
    border-radius: 6px;
    color: #16202e;
    height: 12px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #1d4ed8;
    border-radius: 6px;
}

QScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 2px;
    width: 12px;
}

QScrollBar:horizontal {
    background: transparent;
    border: none;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle {
    background-color: #c3ccd9;
    border-radius: 4px;
    min-height: 32px;
    min-width: 32px;
}

QScrollBar::handle:hover {
    background-color: #a9b6c9;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    background: none;
    border: none;
    height: 0;
    width: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

QSplitter::handle {
    background-color: #e4e9f0;
}

QSplitter::handle:hover {
    background-color: #1d4ed8;
}

QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #d8dee7;
    color: #5a6474;
    min-height: 30px;
    padding: 2px 6px 4px 6px;
}

QStatusBar::item {
    border: none;
}

QWidget#batch_controls_container {
    background-color: transparent;
}

QPushButton#batch_pause,
QPushButton#batch_cancel {
    border-radius: 6px;
    font-size: 12px;
    min-height: 20px;
    padding: 3px 12px;
}

QSpinBox::up-button,
QSpinBox::down-button {
    background-color: #eef1f6;
    border-left: 1px solid #c9d2df;
    subcontrol-origin: border;
    width: 18px;
}

QSpinBox::up-button {
    border-top-right-radius: 6px;
    subcontrol-position: top right;
}

QSpinBox::down-button {
    border-bottom-right-radius: 6px;
    subcontrol-position: bottom right;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #dbe3ef;
}

QToolTip {
    background-color: #16202e;
    border: none;
    border-radius: 6px;
    color: #ffffff;
    padding: 6px 9px;
}

/* Toast notifications */
QFrame[objectName^="toast_"] {
    background-color: #ffffff;
    border: 1px solid #d8dee7;
    border-radius: 8px;
}

QLabel#toast_icon {
    background-color: transparent;
    font-size: 14px;
    font-weight: 700;
}

QLabel#toast_message {
    background-color: transparent;
    color: #16202e;
    font-size: 13px;
}

QPushButton#toast_close {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    color: #5a6474;
    font-size: 13px;
    font-weight: bold;
    padding: 2px;
}

QPushButton#toast_close:hover {
    background-color: #eef1f6;
    color: #16202e;
}

/* Page navigation bar */
QLabel#page_indicator {
    background-color: transparent;
    color: #5a6474;
    font-size: 13px;
    font-weight: 500;
    padding: 2px 8px;
}

QPushButton#prev_page_button,
QPushButton#next_page_button {
    min-width: 32px;
    min-height: 28px;
    padding: 2px 6px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#prev_page_button:disabled,
QPushButton#next_page_button:disabled {
    background-color: #f2f4f7;
    border-color: #e4e9f0;
    color: #98a2b3;
    opacity: 0.6;
}

QScrollBar#page_slider {
    background: #e4e9f0;
    border-radius: 3px;
    height: 6px;
    min-width: 60px;
}

QScrollBar#page_slider::handle {
    background-color: #98a2b3;
    border-radius: 3px;
    min-width: 20px;
}

QScrollBar#page_slider::handle:hover {
    background-color: #1d4ed8;
}

QFrame#nav_bar {
    background-color: #f5f7fa;
    border-top: 1px solid #d8dee7;
}

QLabel#nav_group_label {
    background-color: transparent;
    color: #5a6474;
    font-size: 11px;
    font-weight: 600;
}

QFrame#nav_separator {
    background-color: #d8dee7;
    border: none;
    max-width: 1px;
}

QPushButton#zoom_out_button,
QPushButton#zoom_in_button,
QPushButton#rotate_left_button,
QPushButton#rotate_right_button,
QPushButton#zoom_reset_button,
QPushButton#fit_width_button,
QPushButton#uncertain_prev_button,
QPushButton#uncertain_next_button,
QPushButton#spell_fix_button,
QPushButton#edit_table_button {
    min-height: 20px;
    padding: 4px 10px;
}

QPushButton#zoom_out_button,
QPushButton#zoom_in_button,
QPushButton#rotate_left_button,
QPushButton#rotate_right_button {
    min-width: 30px;
    padding: 2px 6px;
    font-size: 15px;
}

QLabel#zoom_indicator {
    background-color: transparent;
    color: #16202e;
    font-weight: 600;
}

QSpinBox#page_spin {
    padding: 4px 6px;
}

QPushButton#region_insert {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
    color: #ffffff;
}

QPushButton#region_insert:hover {
    background-color: #1a45c0;
}

QPushButton#region_insert:disabled {
    background-color: #eef1f6;
    border-color: #e4e9f0;
    color: #98a2b3;
}

QPushButton#region_copy,
QPushButton#region_rerun,
QPushButton#region_insert {
    min-height: 16px;
    padding: 4px 10px;
}

QLabel#region_source {
    background-color: transparent;
    color: #5a6474;
    font-size: 12px;
}

QSpinBox::up-arrow {
    height: 10px;
    image: url("@ICONS@/chevron-up-light.svg");
    width: 10px;
}

QSpinBox::down-arrow {
    height: 10px;
    image: url("@ICONS@/chevron-down-light.svg");
    width: 10px;
}

QComboBox::down-arrow {
    height: 10px;
    image: url("@ICONS@/chevron-down-light.svg");
    width: 10px;
}

QFrame#region_panel {
    background-color: #f5f8fc;
    border: 1px solid #d9e1ec;
    border-radius: 10px;
}

QLabel#region_title {
    background-color: transparent;
    color: #1d4ed8;
    font-weight: 600;
}

QPlainTextEdit#region_result {
    background-color: #ffffff;
    border: 1px solid #d9e1ec;
    border-radius: 7px;
    padding: 6px 8px;
}


/* Navigation dock, transcript header & settings scroll */
QFrame#file_info_card,
QFrame#structure_panel {
    background-color: #f5f7fa;
    border: 1px solid #d8dee7;
    border-radius: 8px;
}

QLabel#file_name_label,
QLabel#transcript_title_label {
    background-color: transparent;
    color: #16202e;
    font-size: 13px;
    font-weight: 600;
}

QLabel#file_meta_label,
QLabel#ocr_progress_label,
QLabel#doc_search_summary,
QLabel#word_count_label,
QLabel#structure_summary {
    background-color: transparent;
    color: #5a6474;
    font-size: 12px;
}

QProgressBar#ocr_progress_bar {
    background-color: #e4e9f0;
    border: none;
    border-radius: 4px;
    height: 8px;
    max-height: 8px;
    min-height: 8px;
}

QPushButton#ocr_current_page_button {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#ocr_current_page_button:hover {
    background-color: #1a45c0;
}

QPushButton#ocr_current_page_button:disabled {
    background-color: #f2f4f7;
    border-color: #e4e9f0;
    color: #98a2b3;
}

QFrame#transcript_bar {
    background-color: #f5f7fa;
    border: 1px solid #d8dee7;
    border-radius: 8px;
}

QPushButton#find_replace_button,
QPushButton#copy_transcript_button {
    min-height: 20px;
    padding: 4px 10px;
}

QTabWidget#navigation_tabs::pane {
    background-color: transparent;
    border: none;
    padding-top: 6px;
}

QTabBar::tab {
    background-color: #ffffff;
    border: 1px solid #d8dee7;
    border-radius: 6px;
    color: #5a6474;
    margin-right: 4px;
    padding: 5px 10px;
}

QTabBar::tab:hover {
    background-color: #eef1f6;
    color: #16202e;
}

QTabBar::tab:selected {
    background-color: #dbeafe;
    border-color: #1d4ed8;
    color: #16202e;
    font-weight: 600;
}

QScrollArea#settings_scroll_area,
QWidget#settings_scroll_content {
    background-color: transparent;
    border: none;
}

/* Status-bar buttons share the bar's height; the default button padding
   made them taller than the bar, so their borders were cut off. */
QWidget#batch_controls_container QPushButton {
    min-height: 18px;
    padding: 2px 12px;
}

/* Two buttons share the narrow document card. */
QPushButton#pdf_tools_quick_button,
QPushButton#doc_props_quick_button {
    padding: 6px 8px;
}
